                <mxCell id="46" value="&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;#SistemaDeEspera&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;public void AgregarPersona(Persona persona){&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;if(_fila == null){&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;nuevaFila = new MyQueue&amp;lt;Persona&amp;gt;();&lt;/span&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;_filaActual = nuevaFila;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;scrollbar-color: rgb(75, 75, 75) rgb(27, 29, 30);&quot;&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;_filas.add(nuevaFila);&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;}&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;_filaActual.Enqueue(persona)&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;cantidadActual ++;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;if(cantidadActual == 10){&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;DividirFila();&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;}&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;}&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;span class=&quot;ͼv&quot;&gt;public&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;void&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;DividirFila&lt;/span&gt;()&lt;br&gt;{&lt;br&gt;    &lt;span class=&quot;ͼ11&quot;&gt;MyQueue&lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;Persona&lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;&amp;gt;&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;aux&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;new&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;MyQueue&lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;Persona&lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;&amp;gt;&lt;/span&gt;();&lt;br&gt;&lt;br&gt;int cantidadNuevaFila = 0;&lt;br&gt;&lt;br&gt;&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;while&lt;/span&gt;(&lt;span class=&quot;ͼv&quot;&gt;!&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;_filaActual&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;IsEmpty&lt;/span&gt;() &lt;span class=&quot;ͼv&quot;&gt;&amp;amp;&amp;amp;&lt;/span&gt;&amp;nbsp;cantidadNuevaFila &amp;lt;&amp;nbsp;5)&lt;br&gt;    {&lt;br&gt;        &lt;span class=&quot;ͼ11&quot;&gt;Persona&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;persona&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;_filaActual&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Dequeue&lt;/span&gt;();&lt;br&gt;&lt;br&gt;        &lt;span class=&quot;ͼ11&quot;&gt;aux&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Enqueue&lt;/span&gt;(&lt;span class=&quot;ͼ11&quot;&gt;persona&lt;/span&gt;);&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;b&gt;cantidadActual --;&lt;br&gt;&lt;br&gt;cantidadNuevaFila ++;&lt;br&gt;        &lt;span class=&quot;ͼ11&quot;&gt;contar&lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;--&lt;/span&gt;;&lt;br&gt;    }&lt;br&gt;&lt;br&gt;    &lt;span class=&quot;ͼ11&quot;&gt;_filas&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Add&lt;/span&gt;(&lt;span class=&quot;ͼ11&quot;&gt;aux&lt;/span&gt;);&lt;br&gt;}&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="-300" y="20" width="330" height="580" as="geometry"/>
