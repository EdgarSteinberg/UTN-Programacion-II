                <mxCell id="34" value="&lt;b&gt;#Aplicacion&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;public void AgregarDestino(IObserver destino) {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;_destinos.Add(destino)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;public void EliminarDestino(IObserver destino){&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;_destinos.Remove(destino)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span class=&quot;ͼv&quot;&gt;public&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;void&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;EstablecerFechaHora&lt;/span&gt;(&lt;span class=&quot;ͼ11&quot;&gt;DateTime&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;fechaHora&lt;/span&gt;)&lt;br&gt;{&lt;br&gt;    &lt;span class=&quot;ͼ11&quot;&gt;_fechaHoraLocal&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;fechaHora&lt;/span&gt;;&lt;br&gt;&lt;br&gt;    &lt;span class=&quot;ͼ11&quot;&gt;Notificar&lt;/span&gt;();&lt;br&gt;}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span class=&quot;ͼv&quot;&gt;private&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;void&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;Notificar&lt;/span&gt;()&lt;br&gt;{&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;foreach&lt;/span&gt;(&lt;span class=&quot;ͼ11&quot;&gt;IObserver&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;observer&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;in&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;_destinos&lt;/span&gt;)&lt;br&gt;    {&lt;br&gt;        &lt;span class=&quot;ͼ11&quot;&gt;observer&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Actualizar&lt;/span&gt;(&lt;span class=&quot;ͼ11&quot;&gt;_fechaHoraLocal&lt;/span&gt;);&lt;br&gt;    }&lt;br&gt;}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
