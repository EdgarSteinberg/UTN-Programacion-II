                </mxCell>
                <mxCell id="125" value="&lt;b&gt;&lt;span class=&quot;ͼv&quot;&gt;public&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;int&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;CalcularDias&lt;/span&gt;()&lt;br&gt;{&lt;br&gt;&lt;span class=&quot;ͼ11&quot;&gt;int&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;dias&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;FechaEgreso&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;-&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;FechaIngreso&lt;/span&gt;;&lt;br&gt;&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;return dias;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;span class=&quot;ͼv&quot;&gt;public&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;void&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;ConfirmarReserva&lt;/span&gt;()&lt;br&gt;{&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;foreach&lt;/span&gt;(&lt;span class=&quot;ͼ11&quot;&gt;Habitacion&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;habitacion&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;in&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;_habitaciones&lt;/span&gt;)&lt;br&gt;    {&lt;br&gt;        &lt;span class=&quot;ͼv&quot;&gt;if&lt;/span&gt;(&lt;span class=&quot;ͼv&quot;&gt;!&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;habitacion&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;EstaDisponible&lt;/span&gt;())&lt;br&gt;        {&lt;br&gt;            &lt;span class=&quot;ͼv&quot;&gt;throw&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;new&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;Exception&lt;/span&gt;(&lt;span class=&quot;ͼz&quot;&gt;&quot;No disponible&quot;&lt;/span&gt;);&lt;br&gt;        }&lt;br&gt;    }&lt;br&gt;&lt;br&gt;&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;foreach&lt;/span&gt;(&lt;span class=&quot;ͼ11&quot;&gt;Habitacion&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;habitacion&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;in&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;_habitaciones&lt;/span&gt;)&lt;br&gt;    {&lt;br&gt;        &lt;span class=&quot;ͼ11&quot;&gt;habitacion&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Reservar&lt;/span&gt;();&lt;br&gt;    }&lt;br&gt;}&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;public double CalcularPrecioFinal(ITemporada temporada)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; double precioTotal = 0;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; int cantidadDias = CalcularDias();&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; foreach(Habitacion habitacion in _habitaciones)&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; double precioHabitacion = habitacion.PrecioPorDia();&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;double valorRegimen = habitacion.CalcularValorRegimen()&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp;&amp;nbsp; &amp;nbsp; &amp;nbsp; precioTotal += temporada.CalcularValorTemporada(&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; precioHabitacion,&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; &amp;nbsp; valorRegimenl,&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cantidadDias&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; );&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; return precioTotal;&lt;/b&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=#0e8088;fillColor=#b0e3e6;" vertex="1" parent="1">
                    <mxGeometry x="580" y="-195" width="380" height="660" as="geometry"/>
