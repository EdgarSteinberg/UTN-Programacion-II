                <mxCell id="147" value="&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;public class Combo : IProducto&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;{&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; private string nombre;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; private List&amp;lt;IProducto&amp;gt; productos;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; public Combo(string nombre)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; this.nombre = nombre;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; productos = new List&amp;lt;IProducto&amp;gt;();&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; public void Agregar(IProducto producto)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; productos.Add(producto);&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; public void Imprimir()&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Console.WriteLine(&quot;Combo &quot; + nombre);&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; foreach(IProducto producto in productos)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; producto.Imprimir();&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-weight: normal; color: light-dark(rgb(0, 0, 0), rgb(255, 246, 243));&quot;&gt;}&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontStyle=1" vertex="1" parent="1">
