                <mxCell id="41" value="&lt;div&gt;&lt;b&gt;public void Despachar(int hora)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;{&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; int cantidadCartas = 0;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; int cantidadADespachar = 5;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;else&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼ11&quot;&gt;hora&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;==&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼy&quot;&gt;16&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;&amp;amp;&amp;amp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼ11&quot;&gt;cantidadCartas&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;&amp;gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼy&quot;&gt;5&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;)&lt;br&gt;{&lt;br&gt;    &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼ11&quot;&gt;cantidadADespachar&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼ11&quot;&gt;cantidadCartas&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;-&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼy&quot;&gt;5&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;;&lt;br&gt;}&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;else&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼ11&quot;&gt;hora&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;==&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼy&quot;&gt;16&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;)&lt;br&gt;{&lt;br&gt;    &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼ11&quot;&gt;cantidadADespachar&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼy&quot;&gt;0&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;;&lt;br&gt;}&lt;br&gt;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;else&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;if&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;(&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼ11&quot;&gt;hora&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;==&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼy&quot;&gt;17&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;)&lt;br&gt;{&lt;br&gt;    &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼ11&quot;&gt;cantidadADespachar&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼv&quot;&gt;=&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt; &lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot; class=&quot;ͼ11&quot;&gt;cantidadCartas&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;;&lt;br&gt;}&lt;/span&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; while(!_cartas.IsEmpty() &amp;amp;&amp;amp; cantidadCartas &amp;lt; cantidadADespachar)&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; {&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Carta cartaActual = _cartas.Pop();&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cantidadCartas++;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; // despachar cartaActual&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&amp;nbsp; &amp;nbsp; }&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;}&lt;/b&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
