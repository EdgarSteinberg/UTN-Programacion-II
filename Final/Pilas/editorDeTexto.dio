                <mxCell id="48" value="&lt;span class=&quot;ͼv&quot;&gt;public&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;void&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;Rehacer&lt;/span&gt;()&lt;br&gt;{&lt;br&gt;    &lt;span class=&quot;ͼ11&quot;&gt;bool&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;cortar&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;ͼy&quot;&gt;false&lt;/span&gt;;&lt;br&gt;&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;while&lt;/span&gt; (&lt;span class=&quot;ͼv&quot;&gt;!&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;_rehacer&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;IsEmpty&lt;/span&gt;() &lt;span class=&quot;ͼv&quot;&gt;&amp;amp;&amp;amp;&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;!&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;cortar&lt;/span&gt;)&lt;br&gt;    {&lt;br&gt;        &lt;span class=&quot;ͼ11&quot;&gt;Accion&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;accion&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;_rehacer&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Pop&lt;/span&gt;();&lt;br&gt;&lt;br&gt;        &lt;span class=&quot;ͼv&quot;&gt;if&lt;/span&gt; (&lt;span class=&quot;ͼ11&quot;&gt;accion&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Tipo&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;!=&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;SUBRAYAR&lt;/span&gt;)&lt;br&gt;        {&lt;br&gt;            &lt;span class=&quot;ͼ11&quot;&gt;_acciones&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Push&lt;/span&gt;(&lt;span class=&quot;ͼ11&quot;&gt;accion&lt;/span&gt;);&lt;br&gt;        }&lt;br&gt;&lt;br&gt;        &lt;span class=&quot;ͼv&quot;&gt;if&lt;/span&gt; (&lt;span class=&quot;ͼ11&quot;&gt;accion&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Tipo&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;==&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;REDACTAR&lt;/span&gt;)&lt;br&gt;        {&lt;br&gt;            &lt;span class=&quot;ͼ11&q