                <mxCell id="112" value="#ListaPrecio&lt;div&gt;public void Imprimir () {&lt;/div&gt;&lt;div&gt;Console.WriteLine($&quot;Lista de Precio: {this.Nombre} - Vigencia &quot;)&lt;/div&gt;&lt;div&gt;forEach(var articulo in this.Articulos){&lt;/div&gt;&lt;div&gt;Console.Writeline(articulo.LineaDetalle()&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;}&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
