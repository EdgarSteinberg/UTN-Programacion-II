                </mxCell>
                <mxCell id="27" value="&lt;div class=&quot;pointer-events-none absolute inset-x-4 top-12 bottom-4&quot;&gt;&lt;div class=&quot;pointer-events-none sticky z-40 shrink-0 z-1!&quot;&gt;&lt;div class=&quot;sticky bg-token-border-light&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼs ͼ16&quot; dir=&quot;ltr&quot; id=&quot;code-block-viewer&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span class=&quot;ͼv&quot;&gt;public&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;Cliente&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;AtenderCliente&lt;/span&gt;()&lt;br&gt;{&lt;br&gt;    &lt;span class=&quot;ͼt&quot;&gt;// 1. prioridad absoluta: embarazada premium&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;ͼ11&quot;&gt;Cliente&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;c&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;BuscarEmbarazada&lt;/span&gt;(&lt;span class=&quot;ͼ11&quot;&gt;_premium&lt;/span&gt;);&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;if&lt;/span&gt; (&lt;span class=&quot;ͼ11&quot;&gt;c&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;!=&lt;/span&gt; &lt;span class=&quot;ͼy&quot;&gt;null&lt;/span&gt;) &lt;span class=&quot;ͼv&quot;&gt;return&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;c&lt;/span&gt;;&lt;br&gt;&lt;br&gt;    &lt;span class=&quot;ͼt&quot;&gt;// 2. prioridad absoluta: embarazada común&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;ͼ11&quot;&gt;c&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;BuscarEmbarazada&lt;/span&gt;(&lt;span class=&quot;ͼ11&quot;&gt;_comunes&lt;/span&gt;);&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;if&lt;/span&gt; (&lt;span class=&quot;ͼ11&quot;&gt;c&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;!=&lt;/span&gt; &lt;span class=&quot;ͼy&quot;&gt;null&lt;/span&gt;) &lt;span class=&quot;ͼv&quot;&gt;return&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;c&lt;/span&gt;;&lt;br&gt;&lt;br&gt;    &lt;span class=&quot;ͼt&quot;&gt;// 3. regla premium &amp;gt; 2&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;if&lt;/span&gt; (&lt;span class=&quot;ͼ11&quot;&gt;_premiumCount&lt;/span&gt;() &lt;span class=&quot;ͼv&quot;&gt;&amp;gt;&lt;/span&gt; &lt;span class=&quot;ͼy&quot;&gt;2&lt;/span&gt;)&lt;br&gt;    {&lt;br&gt;        &lt;span class=&quot;ͼv&quot;&gt;return&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;_premium&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Dequeue&lt;/span&gt;();&lt;br&gt;    }&lt;br&gt;&lt;br&gt;    &lt;span class=&quot;ͼt&quot;&gt;// 4. alternancia&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;if&lt;/span&gt; (&lt;span class=&quot;ͼ11&quot;&gt;turnoPremium&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;&amp;amp;&amp;amp;&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;!&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;_premium&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;IsEmpty&lt;/span&gt;())&lt;br&gt;    {&lt;br&gt;        &lt;span class=&quot;ͼ11&quot;&gt;turnoPremium&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;ͼy&quot;&gt;false&lt;/span&gt;;&lt;br&gt;        &lt;span class=&quot;ͼv&quot;&gt;return&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;_premium&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Dequeue&lt;/span&gt;();&lt;br&gt;    }&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;else&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;if&lt;/span&gt; (&lt;span class=&quot;ͼv&quot;&gt;!&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;_comunes&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;IsEmpty&lt;/span&gt;())&lt;br&gt;    {&lt;br&gt;        &lt;span class=&quot;ͼ11&quot;&gt;turnoPremium&lt;/span&gt; &lt;span class=&quot;ͼv&quot;&gt;=&lt;/span&gt; &lt;span class=&quot;ͼy&quot;&gt;true&lt;/span&gt;;&lt;br&gt;        &lt;span class=&quot;ͼv&quot;&gt;return&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;_comunes&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Dequeue&lt;/span&gt;();&lt;br&gt;    }&lt;br&gt;&lt;br&gt;    &lt;span class=&quot;ͼt&quot;&gt;// fallback&lt;/span&gt;&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;if&lt;/span&gt; (&lt;span class=&quot;ͼv&quot;&gt;!&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;_premium&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;IsEmpty&lt;/span&gt;()) &lt;span class=&quot;ͼv&quot;&gt;return&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;_premium&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Dequeue&lt;/span&gt;();&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;if&lt;/span&gt; (&lt;span class=&quot;ͼv&quot;&gt;!&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;_comunes&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;IsEmpty&lt;/span&gt;()) &lt;span class=&quot;ͼv&quot;&gt;return&lt;/span&gt; &lt;span class=&quot;ͼ11&quot;&gt;_comunes&lt;/span&gt;.&lt;span class=&quot;ͼ11&quot;&gt;Dequeue&lt;/span&gt;();&lt;br&gt;&lt;br&gt;    &lt;span class=&quot;ͼv&quot;&gt;return&lt;/span&gt; &lt;span class=&quot;ͼy&quot;&gt;null&lt;/span&gt;;&lt;br&gt;}&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="230" y="340" width="390" height="530" as="geometry"/>
                </mxCell>
                <mxCell id="28" value="&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;private Cliente BuscarEmbarazada(MyQueue&amp;lt;Cliente&amp;gt; cola)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;{&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; var aux = new MyQueue&amp;lt;Cliente&amp;gt;();&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; Cliente encontrado = null;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; while (!cola.IsEmpty())&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; Cliente c = cola.Dequeue();&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; if (c.EsMujer &amp;amp;&amp;amp; c.EstaEmbarazada &amp;amp;&amp;amp; encontrado == null)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; encontrado = c;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; else&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; {&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; aux.Enqueue(c);&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; }&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; while (!aux.IsEmpty())&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cola.Enqueue(aux.Dequeue());&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; if (encontrado != null)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; cola.Enqueue(encontrado);&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;&amp;nbsp; &amp;nbsp; return encontrado;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;}&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
                    <mxGeometry x="-140" y="340" width="370" height="420" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
