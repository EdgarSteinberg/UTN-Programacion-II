                <mxCell id="26" value="&lt;div class=&quot;pointer-events-none absolute inset-x-4 top-12 bottom-4&quot;&gt;&lt;div class=&quot;pointer-events-none sticky z-40 shrink-0 z-1!&quot;&gt;&lt;div class=&quot;sticky bg-token-border-light&quot;&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;relative&quot;&gt;&lt;div class=&quot;&quot;&gt;&lt;div class=&quot;relative z-0 flex max-w-full&quot;&gt;&lt;div id=&quot;code-block-viewer&quot; dir=&quot;ltr&quot; class=&quot;q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼs ͼ16&quot;&gt;&lt;div class=&quot;cm-scroller&quot;&gt;&lt;pre class=&quot;cm-content q9tKkq_readonly m-0&quot;&gt;&lt;code&gt;&lt;span class=&quot;ͼv&quot;&gt;private&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;void&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;InsertarConPrioridad&lt;/span&gt;&lt;span&gt;(&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;MyQueue&lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;Cliente&lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;&amp;gt;&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;cola&lt;/span&gt;&lt;span&gt;, &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;Cliente&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;c&lt;/span&gt;&lt;span&gt;)&lt;/span&gt;&lt;br&gt;&lt;span&gt;{&lt;/span&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;if&lt;/span&gt;&lt;span&gt; (&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;c&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;EsMujer&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;&amp;amp;&amp;amp;&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;c&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;EstaEmbarazada&lt;/span&gt;&lt;span&gt;)&lt;/span&gt;&lt;br&gt;&lt;span&gt;    {&lt;/span&gt;&lt;br&gt;&lt;span&gt;        &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;var&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;aux&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;=&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;new&lt;/span&gt;&lt;span&gt; &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;MyQueue&lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;&amp;lt;&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;Cliente&lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;&amp;gt;&lt;/span&gt;&lt;span&gt;();&lt;/span&gt;&lt;br&gt;&lt;span&gt;        &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;aux&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;Enqueue&lt;/span&gt;&lt;span&gt;(&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;c&lt;/span&gt;&lt;span&gt;);&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;        &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;while&lt;/span&gt;&lt;span&gt; (&lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;!&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;cola&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;IsEmpty&lt;/span&gt;&lt;span&gt;())&lt;/span&gt;&lt;br&gt;&lt;span&gt;            &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;aux&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;Enqueue&lt;/span&gt;&lt;span&gt;(&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;cola&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;Dequeue&lt;/span&gt;&lt;span&gt;());&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;span&gt;        &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;while&lt;/span&gt;&lt;span&gt; (&lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;!&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;aux&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;IsEmpty&lt;/span&gt;&lt;span&gt;())&lt;/span&gt;&lt;br&gt;&lt;span&gt;            &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;cola&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;Enqueue&lt;/span&gt;&lt;span&gt;(&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;aux&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;Dequeue&lt;/span&gt;&lt;span&gt;());&lt;/span&gt;&lt;br&gt;&lt;span&gt;    }&lt;/span&gt;&lt;br&gt;&lt;span&gt;    &lt;/span&gt;&lt;span class=&quot;ͼv&quot;&gt;else&lt;/span&gt;&lt;br&gt;&lt;span&gt;    {&lt;/span&gt;&lt;br&gt;&lt;span&gt;        &lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;cola&lt;/span&gt;&lt;span&gt;.&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;Enqueue&lt;/span&gt;&lt;span&gt;(&lt;/span&gt;&lt;span class=&quot;ͼ11&quot;&gt;c&lt;/span&gt;&lt;span&gt;);&lt;/span&gt;&lt;br&gt;&lt;span&gt;    }&lt;/span&gt;&lt;br&gt;&lt;span&gt;}&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
