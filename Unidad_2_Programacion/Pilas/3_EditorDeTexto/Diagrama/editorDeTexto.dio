                <mxCell id="62" value="+ ejecutarAccion(a: Accion)&lt;br&gt;{&lt;br&gt;    a.ejecutar();&lt;br&gt;    undoStack.push(a);&lt;br&gt;    redoStack = new MyStack&amp;lt;Accion&amp;gt;();&lt;br&gt;}&lt;br&gt;&lt;br&gt;+ deshacer()&lt;br&gt;{&lt;br&gt;    if (undoStack.isEmpty()) return;&lt;br&gt;&lt;br&gt;    var a = undoStack.pop();&lt;br&gt;    a.deshacer();&lt;br&gt;    redoStack.push(a);&lt;br&gt;}&lt;br&gt;&lt;br&gt;+ rehacer()&lt;br&gt;{&lt;br&gt;    if (redoStack.isEmpty()) return;&lt;br&gt;&lt;br&gt;    var a = redoStack.pop();&lt;br&gt;    a.ejecutar();" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
