                <mxCell id="20" value="#Browser&lt;div&gt;public void goTo(string url){&lt;/div&gt;&lt;div&gt;this.historial.Push(currentUrl)&lt;/div&gt;&lt;div&gt;this.CurrentUrl = url;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;public void GoBack(string url){&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;this.CurrentUrl =&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;this.historial.Pop&lt;/span&gt;&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;public void PrinHistory(){&lt;/div&gt;&lt;div&gt;this.Historial.PrintHistory()&lt;/div&gt;&lt;div&gt;}&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="1" vertex="1">
